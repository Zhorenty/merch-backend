# HTTP
HTTP_ADDR=:8080
API_BASE_URL=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080
# Comma-separated. Empty = PUBLIC_BASE_URL only.
CORS_ORIGINS=http://localhost:8080

# sqlite:./data/merch.db  OR  postgres://merch:merch@localhost:5432/merch?sslmode=disable
DATABASE_URL=sqlite:./data/merch.db

# JWT (generate unique values in production)
CASHIER_JWT_SECRET=change-me-cashier
ADMIN_JWT_SECRET=change-me-admin

# Bootstrap admin created on first start if login does not exist
ADMIN_BOOTSTRAP_LOGIN=admin
ADMIN_BOOTSTRAP_PASSWORD=changeme
ADMIN_BOOTSTRAP_NAME=Админ

# Optional demo cashier (development)
CASHIER_BOOTSTRAP_LOGIN=
CASHIER_BOOTSTRAP_PASSWORD=
CASHIER_BOOTSTRAP_NAME=Кассир

# Loyalty contact (printed on the pass)
TERMS_URL=https://example.com/loyalty-terms
SUPPORT_CONTACT=Telegram @merch

# Cashier APK
APP_MIN_SUPPORTED=1.0.0
APP_DOWNLOAD_URL=https://example.com/merch-kassa.apk

# Apple PassKit (leave paths empty to use Disabled/FileStub adapters)
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=pass.com.merch.loyalty
APPLE_PASS_CERT_P12=
APPLE_PASS_CERT_PASSWORD=
APPLE_WWDR_CERT=
APPLE_APNS_P8=
APPLE_APNS_KEY_ID=
APPLE_APNS_PRODUCTION=false

# Google Wallet (leave empty for no-op adapter)
GOOGLE_ISSUER_ID=
GOOGLE_SA_JSON=
GOOGLE_CLASS_SUFFIX=merch_loyalty

# Pass colors (rgb, used in pass.json)
PASS_BG_COLOR=rgb(26,26,26)
PASS_FG_COLOR=rgb(245,245,245)
PASS_LABEL_COLOR=rgb(180,180,180)
