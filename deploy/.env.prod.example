# Copy to /opt/merch/deploy/.env on the VPS (mode 600). Do not commit real values.

POSTGRES_USER=merch
POSTGRES_PASSWORD=
POSTGRES_DB=merch

HTTP_ADDR=:8080
DATABASE_URL=postgres://merch:CHANGE_ME@postgres:5432/merch?sslmode=disable
API_BASE_URL=https://api.merch-wallet.ru
PUBLIC_BASE_URL=https://api.merch-wallet.ru
CORS_ORIGINS=https://api.merch-wallet.ru

CASHIER_JWT_SECRET=
ADMIN_JWT_SECRET=

ADMIN_BOOTSTRAP_LOGIN=admin
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Админ

TERMS_URL=https://api.merch-wallet.ru/loyalty-terms
SUPPORT_CONTACT=Telegram @merch
APP_MIN_SUPPORTED=1.0.0
APP_DOWNLOAD_URL=https://api.merch-wallet.ru/static/merch-kassa.apk

APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=pass.com.merch.loyalty
APPLE_PASS_CERT_P12=
APPLE_PASS_CERT_PASSWORD=
APPLE_WWDR_CERT=
APPLE_APNS_P8=
APPLE_APNS_KEY_ID=
APPLE_APNS_PRODUCTION=false
GOOGLE_ISSUER_ID=
GOOGLE_SA_JSON=
GOOGLE_CLASS_SUFFIX=merch_loyalty
