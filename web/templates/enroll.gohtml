<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>MERCH — получить карту</title>
  <style>
    :root { color-scheme: dark; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background:#111; color:#f5f5f5; margin:0; }
    .wrap { max-width: 420px; margin: 0 auto; padding: 32px 20px; }
    h1 { letter-spacing: .2em; font-weight: 600; font-size: 22px; }
    label { display:block; margin: 14px 0 6px; color:#bbb; font-size: 14px; }
    input { width:100%; box-sizing:border-box; padding:12px; border:0; border-radius:8px; background:#222; color:#fff; font-size:16px; }
    button { margin-top:20px; width:100%; padding:14px; border:0; border-radius:8px; background:#f5f5f5; color:#111; font-weight:600; font-size:16px; }
    .hint { color:#888; font-size:13px; margin-top:16px; line-height:1.4; }
    .err { color:#ff8a80; margin-top:12px; }
  </style>
</head>
<body>
  <div class="wrap">
    <h1>MERCH</h1>
    <p>Карта лояльности. Имя и телефон обязательны.</p>
    <form id="f">
      <label for="name">Имя</label>
      <input id="name" name="name" autocomplete="name" placeholder="Анна" required>
      <label for="phone">Телефон</label>
      <input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+7 (900) 000-00-00" maxlength="18" required>
      <button type="submit">Получить карту</button>
    </form>
    <p class="err" id="err" hidden></p>
    <p class="hint">Нажимая кнопку, вы соглашаетесь с <a href="{{.TermsURL}}" style="color:#ddd">правилами</a>. {{.Support}}</p>
  </div>
  <script>
    const phoneInput = document.getElementById('phone');
    function nationalDigits(raw) {
      let digits = (raw || '').replace(/\D/g, '');
      if (digits.startsWith('7') || digits.startsWith('8')) digits = digits.slice(1);
      return digits.slice(0, 10);
    }
    function formatPhone(raw) {
      const d = nationalDigits(raw);
      if (!d) return '';
      let out = '+7 (' + d.slice(0, 3);
      if (d.length <= 3) return out;
      out += ') ' + d.slice(3, 6);
      if (d.length <= 6) return out;
      out += '-' + d.slice(6, 8);
      if (d.length <= 8) return out;
      return out + '-' + d.slice(8, 10);
    }
    phoneInput.addEventListener('input', () => {
      const next = formatPhone(phoneInput.value);
      if (phoneInput.value !== next) phoneInput.value = next;
    });
    document.getElementById('f').addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = document.getElementById('err');
      err.hidden = true;
      const name = document.getElementById('name').value.trim();
      const phone = phoneInput.value.trim();
      if (!name || nationalDigits(phone).length !== 10) {
        err.textContent = 'Укажите имя и телефон полностью: +7 и 10 цифр';
        err.hidden = false;
        return;
      }
      try {
        const res = await fetch('/public/enroll', {
          method: 'POST',
          headers: {'Content-Type':'application/json'},
          credentials: 'same-origin',
          body: JSON.stringify({
            name: name,
            phone: phone
          })
        });
        const data = await res.json();
        if (!res.ok) throw new Error((data.error && data.error.message) || 'Ошибка');
        location.href = data.add_page || ('/card/add/' + data.customer_id);
      } catch (x) {
        err.textContent = x.message;
        err.hidden = false;
      }
    });
  </script>
</body>
</html>
